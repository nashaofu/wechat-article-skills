    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.5",
    "@types/yargs": "^17.0.35",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
